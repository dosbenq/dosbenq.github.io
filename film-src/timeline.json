   "end": 2.6300000000000003,
   "caption": "Hey, I'm Aditya."
  },
  {
   "start": 2.68,
   "end": 4.47,
   "caption": "Let me tell you how I got here."
  },
  {
   "start": 4.52,
   "end": 6.7,
   "caption": "It's been the long way round."
  },
  {
   "start": 7.71,
   "end": 12.700000000000001,
   "caption": "I was always the analytical kid.|Math, science, building fun stuff."
  },
  {
   "start": 12.83,
   "end": 14.530000000000001,
   "caption": "So: engineering."
  },
  {
   "start": 14.94,
   "end": 18.759999999999998,
